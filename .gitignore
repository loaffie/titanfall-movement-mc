# titanfall 2 audio (copyrighted game assets, keep them local)

src/main/resources/assets/titanfall_movement/sounds/movement/*.ogg

# ...except the synthesized sounds this mod ships, so it is audible out of the box without any game
# audio. They are generated by tools/generate-audio.py and contain no game asset. Replacing them locally
# with real game audio is fine, but do not commit those; a resource pack is the cleaner way to override them.

!src/main/resources/assets/titanfall_movement/sounds/movement/jump_*.ogg
!src/main/resources/assets/titanfall_movement/sounds/movement/double_jump_*.ogg
!src/main/resources/assets/titanfall_movement/sounds/movement/walljump_*.ogg
!src/main/resources/assets/titanfall_movement/sounds/movement/land_*.ogg
!src/main/resources/assets/titanfall_movement/sounds/movement/wallrun_start.ogg
!src/main/resources/assets/titanfall_movement/sounds/movement/wallrun_loop.ogg
!src/main/resources/assets/titanfall_movement/sounds/movement/slide_start.ogg
!src/main/resources/assets/titanfall_movement/sounds/movement/slide_loop.ogg
